{
  "name": "@aegis/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:execution": "vitest run --config vitest.integration.config.ts src/orchestration",
    "test:messaging": "vitest run --config vitest.integration.config.ts src/orchestration/messaging",
    "ai:evaluate:local": "tsx src/ai/evaluation/run-local-evaluation.ts",
    "ai:evaluate:grounded:local": "tsx src/ai/evaluation/run-grounded-local-evaluation.ts",
    "ai:evaluate:grounded:balanced:local": "tsx src/ai/evaluation/run-grounded-balanced-local-evaluation.ts",
    "ai:evaluate:grounded:qualification-v1:local": "tsx src/ai/evaluation/run-grounded-ai-qualification-v1-local.ts",
    "ai:evaluate:grounded:ai-assisted-exploratory-v1:local": "tsx src/ai/evaluation/run-ai-assisted-exploratory-evaluation-v1-local.ts",
    "ai:evaluate:grounded:reliability:local": "tsx src/ai/evaluation/run-grounded-reliability-local-evaluation.ts",
    "ai:evaluate:grounded:token-budget-512:local": "tsx src/ai/evaluation/run-grounded-token-budget-512-local-evaluation.ts",
    "ai:evaluate:grounded:confidence-contract:local": "tsx src/ai/evaluation/run-grounded-confidence-contract-local-evaluation.ts",
    "ai:evaluate:grounded:supported-decision:local": "tsx src/ai/evaluation/run-grounded-supported-decision-local-evaluation.ts",
    "ai:evaluate:grounded:supported-output-diagnostic:local": "tsx src/ai/evaluation/run-grounded-supported-output-diagnostic-local.ts",
    "db:migrate": "tsx src/storage/migrate-cli.ts",
    "documents:ingest": "tsx src/documents/ingest-cli.ts",
    "documents:ingest-local": "tsx src/documents/ingest-cli.ts --apply-local",
    "cases": "tsx src/storage/cli.ts",
    "memberships": "tsx src/auth/membership-cli.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.213.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/instrumentation": "0.301.0",
    "@opentelemetry/instrumentation-fastify": "0.57.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "fastify": "^5.0.0",
    "jose": "^6.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^6.15.0",
    "tsx": "^4.0.0",
    "vitest": "^5.0.0"
  }
}
