{
  "name": "@aegis/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ai:evaluate:local": "tsx src/ai/evaluation/run-local-evaluation.ts",
    "ai:evaluate:grounded:local": "tsx src/ai/evaluation/run-grounded-local-evaluation.ts",
    "ai:evaluate:grounded:balanced:local": "tsx src/ai/evaluation/run-grounded-balanced-local-evaluation.ts",
    "db:migrate": "tsx src/storage/migrate-cli.ts",
    "documents:ingest": "tsx src/documents/ingest-cli.ts",
    "cases": "tsx src/storage/cli.ts",
    "memberships": "tsx src/auth/membership-cli.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "ajv": "^6.15.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^5.0.0"
  }
}
