{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch --show-current)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run test:integration)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin HEAD:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)"
    ],
    "ask": [
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Edit(./infra/**)",
      "Write(./infra/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./docs/AI-EVALUATION-*.md)",
      "Edit(./docs/AI-*-M4.*.md)",
      "Edit(./docs/AI-CONFIDENCE-CONTRACT-EXPERIMENT-M4.17.md)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.local/**)",
      "Bash(git push * main:*)",
      "Bash(git push origin main:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git clean:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh release:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(npm publish:*)",
      "Bash(ollama:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
