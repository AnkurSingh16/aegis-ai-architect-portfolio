{
  "name": "aegis-ai-architect-portfolio",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test infra/terraform/auth0/hcp-preflight.test.mjs infra/terraform/auth0/apply-first-deployment.test.mjs infra/terraform/auth0/apply-browser-origin-update.test.mjs infra/terraform/auth0/diagnose-browser-origin-plan.test.mjs infra/terraform/auth0/plan-state-reconciliation.test.mjs infra/terraform/auth0/apply-state-reconciliation.test.mjs infra/terraform/auth0/inspect-spa-jwt-alg.test.mjs apps/api/scripts/auth0-pkce-smoke.test.mjs && npm run test --workspaces",
    "test:coverage": "node --experimental-test-coverage --test infra/terraform/auth0/hcp-preflight.test.mjs infra/terraform/auth0/apply-first-deployment.test.mjs infra/terraform/auth0/apply-browser-origin-update.test.mjs infra/terraform/auth0/diagnose-browser-origin-plan.test.mjs infra/terraform/auth0/plan-state-reconciliation.test.mjs infra/terraform/auth0/apply-state-reconciliation.test.mjs infra/terraform/auth0/inspect-spa-jwt-alg.test.mjs apps/api/scripts/auth0-pkce-smoke.test.mjs && npm run test:coverage --workspaces",
    "build": "npm run build --workspaces",
    "db:migrate": "npm run db:migrate -w apps/api",
    "cases": "npm run cases -w apps/api --",
    "memberships": "npm run memberships -w apps/api --",
    "test:integration": "npm run test:integration -w apps/api",
    "test:execution": "npm run test:execution -w apps/api",
    "test:stack": "node scripts/stack-acceptance.mjs",
    "test:availability": "node scripts/availability-policy-check.mjs",
    "test:observability": "node scripts/observability-check.mjs",
    "spire:bootstrap": "node scripts/spire-bootstrap.mjs",
    "spire:register": "node scripts/spire-register.mjs",
    "test:spire": "node scripts/spire-acceptance.mjs",
    "test:p5": "node scripts/p5-acceptance.mjs",
    "test:spire:outage": "node scripts/spire-acceptance.mjs --outage",
    "test:tempo-wal": "node scripts/tempo-wal-check.mjs --iterations=2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.0.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
