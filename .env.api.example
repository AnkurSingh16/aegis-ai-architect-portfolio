# Runtime-only settings for the HTTP API. Copy to ignored .env.api.
# Do not add administrator credentials or membership provisioning settings here.
DATABASE_URL=postgres://aegis_app:replace-with-separate-runtime-password@127.0.0.1:5432/aegis_local
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://aegis-api.example
