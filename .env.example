# Local synthetic demo only. Replace placeholders before starting Compose.
POSTGRES_PASSWORD=replace-with-local-admin-password
DATABASE_ADMIN_URL=postgres://aegis_local:replace-with-local-admin-password@127.0.0.1:5432/aegis_local
DATABASE_APP_PASSWORD=replace-with-separate-runtime-password
DATABASE_URL=postgres://aegis_app:replace-with-separate-runtime-password@127.0.0.1:5432/aegis_local
AEGIS_DEV_FIXTURE=north
# Dedicated integration database. Create it separately; never use aegis_local.
TEST_DATABASE_ADMIN_URL=postgres://aegis_local:replace-with-local-admin-password@127.0.0.1:5432/aegis_test
TEST_DATABASE_URL=postgres://aegis_app:replace-with-separate-runtime-password@127.0.0.1:5432/aegis_test
