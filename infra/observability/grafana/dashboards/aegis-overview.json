{
  "uid": "aegis-overview",
  "title": "AEGIS local overview (provisional thresholds)",
  "tags": ["aegis", "local"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "API liveness", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{target=\"api-liveness\"}" }] },
    { "id": 2, "type": "stat", "title": "API readiness (database and migrations)", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{target=\"api-readiness\"}" }] },
    { "id": 3, "type": "stat", "title": "Identity provider readiness", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{target=\"identity-provider-readiness\"}" }] },
    { "id": 4, "type": "stat", "title": "Web probe", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_success{target=\"web\"}" }] },
    { "id": 5, "type": "timeseries", "title": "Request rate by route and status", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count[5m]))", "legendFormat": "{{http_route}} {{http_response_status_code}}" }] },
    { "id": 6, "type": "timeseries", "title": "API p95 latency", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }] },
    { "id": 7, "type": "timeseries", "title": "Authentication outcomes", "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (aegis_identity_outcome) (rate(aegis_identity_verifications_total[5m]))", "legendFormat": "{{aegis_identity_outcome}}" }] },
    { "id": 8, "type": "timeseries", "title": "Database client operation duration (p95)", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_operation_duration_seconds_bucket[5m])))", "legendFormat": "p95" }] },
    { "id": 9, "type": "timeseries", "title": "Telemetry export failures (spans)", "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans[5m]))", "legendFormat": "{{exporter}}" }] },
    { "id": 10, "type": "logs", "title": "API logs", "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=\"aegis-api\"}" }] }
  ]
}
